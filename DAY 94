#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<int> arr(n);
    for (int i = 0; i < n; i++) cin >> arr[i];

    int maxVal = *max_element(arr.begin(), arr.end());

    vector<int> freq(maxVal + 1, 0);
    for (int x : arr) freq[x]++;

    for (int i = 1; i <= maxVal; i++) {
        freq[i] += freq[i - 1];
    }

    vector<int> output(n);
    for (int i = n - 1; i >= 0; i--) {
        output[--freq[arr[i]]] = arr[i];
    }

    for (int x : output) cout << x << " ";
    return 0;
}
