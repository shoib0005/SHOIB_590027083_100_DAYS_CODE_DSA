#include <bits/stdc++.h>
using namespace std;

bool canAllocate(vector<int>& books, int m, int maxPages) {
    int students = 1;
    int pages = 0;

    for (int b : books) {
        if (b > maxPages) return false;

        if (pages + b > maxPages) {
            students++;
            pages = b;
        } else {
            pages += b;
        }
    }

    return students <= m;
}

int main() {
    int n, m;
    cin >> n >> m;

    vector<int> books(n);
    for (int i = 0; i < n; i++) cin >> books[i];

    if (m > n) {
        cout << -1;
        return 0;
    }

    int left = *max_element(books.begin(), books.end());
    int right = accumulate(books.begin(), books.end(), 0);
    int ans = right;

    while (left <= right) {
        int mid = left + (right - left) / 2;

        if (canAllocate(books, m, mid)) {
            ans = mid;
            right = mid - 1;
        } else {
            left = mid + 1;
        }
    }

    cout << ans;
    return 0;
}
