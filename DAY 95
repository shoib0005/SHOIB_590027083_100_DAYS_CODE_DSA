#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<float> arr(n);
    for (int i = 0; i < n; i++) cin >> arr[i];

    vector<vector<float>> buckets(n);

    for (int i = 0; i < n; i++) {
        int idx = n * arr[i];
        buckets[idx].push_back(arr[i]);
    }

    for (int i = 0; i < n; i++) {
        sort(buckets[i].begin(), buckets[i].end());
    }

    for (int i = 0; i < n; i++) {
        for (float x : buckets[i]) {
            cout << x << " ";
        }
    }

    return 0;
}
